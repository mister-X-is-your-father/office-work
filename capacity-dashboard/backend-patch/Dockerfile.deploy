# 配布用イメージ（軽量パス）: ネイティブ go build した CGO 動的バイナリを glibc ベースに載せる。
# 公式は static/scratch だが、本パッチは xgo を避けて golang:1.22(debian) でビルドするため glibc 必要。
# 事前に: frontend を一度ビルド → `go build -buildvcs=false -ldflags "-s -w" -o vikunja .`
FROM debian:bookworm-slim
LABEL maintainer="capacity-dashboard backend-patch (timetracking fork)"

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/vikunja
COPY vikunja /app/vikunja/vikunja

ENV VIKUNJA_SERVICE_ROOTPATH=/app/vikunja/
ENV VIKUNJA_DATABASE_PATH=/db/vikunja.db
EXPOSE 3456
USER 1000
ENTRYPOINT ["/app/vikunja/vikunja"]
